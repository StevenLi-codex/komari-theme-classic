{
  "name": "x86 Monitor",
  "short": "x86-monitor",
  "description": "Windows 95 与 Windows 2000 复古中文 VPS 卡片监控主题",
  "version": "0.3.0",
  "author": "x86 Monitor Contributors",
  "url": "",
  "config": [
    {
      "type": "title",
      "label": "经典桌面"
    },
    {
      "key": "site_label",
      "type": "string",
      "label": "主标题",
      "default": "节点管理器"
    },
    {
      "key": "columns",
      "type": "number",
      "label": "宽屏卡片列数",
      "default": 4,
      "min": 2,
      "max": 5
    },
    {
      "key": "show_sidebar",
      "type": "boolean",
      "label": "显示左侧导航树",
      "default": true
    },
    {
      "key": "show_chart",
      "type": "boolean",
      "label": "显示 24 小时 CPU 历史曲线",
      "default": true
    },
    {
      "key": "show_traffic",
      "type": "boolean",
      "label": "显示流量速率",
      "default": true
    },
    {
      "key": "notice",
      "type": "text",
      "label": "公告",
      "default": ""
    }
  ]
}
